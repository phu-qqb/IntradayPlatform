{
  "schemaVersion": "2.2",
  "description": "QQ84 proposed one-shot operator runtime-root/source-cutoff repair, fixed bytes, Anubis Demo only; installation expires 2026-09-17 19:00 UTC; no compute or orders.",
  "mainSteps": [
    {
      "action": "aws:runPowerShellScript",
      "name": "InstallPinnedRuntimeRepair",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Windows"
        ]
      },
      "inputs": {
        "timeoutSeconds": "120",
        "runCommand": [
          "# Fixed QQ84 operator repair. No parameters, native computation or order entry.",
          "# Source: phu-qqb/IntradayPlatform commit 0bad940c2f69fd095a364267ad389183dd7afcc2.",
          "Set-StrictMode -Version Latest",
          "$ErrorActionPreference = 'Stop'",
          "$expires = [DateTimeOffset]::Parse('2026-09-17T19:00:00Z')",
          "$operatorRoot = 'D:\\anubis-benchmark\\operator\\lmax-demo-orchestration'",
          "$target = Join-Path $operatorRoot 'Invoke-LmaxDemoAnubisCycle.ps1'",
          "$backup = Join-Path $operatorRoot 'Invoke-LmaxDemoAnubisCycle.pre-runtime-repair-20260917.ps1'",
          "$pending = Join-Path $operatorRoot 'Invoke-LmaxDemoAnubisCycle.runtime-repair-20260917.pending'",
          "$materializer = Join-Path $operatorRoot 'Materialize-LmaxDemoV1.mjs'",
          "$toolingCommit = '33c878837ec504cc1be790b5ad72db03c48ed6c0'",
          "$toolRoot = Join-Path ('D:\\anubis-benchmark\\tools\\' + $toolingCommit) 'tools\\anubis_gpu_benchmark'",
          "$oldHash = 'b4299795d99d4e017375b252e0a4eb2f25f9be865c4b316ab7275f2611f3df00'",
          "$newHash = '39fe977584756261dfc9c357d6b37d4a86dc6e87cebac8f55d4ef89a0672827a'",
          "$materializerHash = '15737571bb990a31f629f85b4c219aad11c9e66123089b76714d163fdde2ca57'",
          "$toolingBlobs = @{",
          "    'cli.mjs' = 'ec3f87a2e9149482ec5d740bf26e5f5dfe2ec8a5'",
          "    'contracts.mjs' = 'd41363eea82de856ec6f483c3222c36875b8a3ac'",
          "    'daily-session-cli.mjs' = '53d75241968d938f0fd5b39d187d1c86cbd1af8f'",
          "    'daily-session-guards.mjs' = '479cb861a10a563d84fb4c004f0a8888910e1809'",
          "    'daily-session.mjs' = 'ea0095f58c184dc7a70a0ad916e75457edf92135'",
          "    'evaluate-semantic-result.mjs' = '024ef5e6ea3af7af27ed7208eb62dd5f493c917e'",
          "    'gpu-baseline.mjs' = '044dbb5886c458968e6ff080c869812fd028c097'",
          "    'market-data-gap-fill-cli.mjs' = '22f461392a77e3e2b8e5c84f8551e7d7e1a25ef8'",
          "    'market-data-gap-fill.mjs' = '77840ecb97d4c6ec4713859273eae7027f436446'",
          "    'r083-decision-slice.mjs' = '7104d023e42d9b85bf06ea2c7415b7a3bb628cfb'",
          "    'run-smoke.mjs' = '7e99a9533d2853813f9dd219a1d34873419c7715'",
          "    'runtime-isolation.mjs' = '2851402deeecb7154ee326aa0de9d36dae9b5f03'",
          "    'validate-constituents.mjs' = '8dce5b1d9ad39d44cf5fc5a46ff26b73e657e452'",
          "}",
          "function File-Hash([string]$Path) {",
          "    (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()",
          "}",
          "function Require-File([string]$Path) {",
          "    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { throw \"REPAIR_REQUIRED_FILE_MISSING:$Path\" }",
          "    if (((Get-Item -LiteralPath $Path).Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw \"REPAIR_REPARSE_POINT_REJECTED:$Path\" }",
          "}",
          "if ([DateTimeOffset]::UtcNow -ge $expires) { throw 'REPAIR_EXPIRED' }",
          "if ($env:COMPUTERNAME -ne 'EC2AMAZ-PG8JLJ5') { throw 'REPAIR_WRONG_HOST' }",
          "if (-not (Test-Path -LiteralPath $operatorRoot -PathType Container)) { throw 'REPAIR_OPERATOR_ROOT_MISSING' }",
          "foreach ($directory in @('D:\\anubis-benchmark', 'D:\\anubis-benchmark\\operator', $operatorRoot,",
          "        'D:\\anubis-benchmark\\tools', ('D:\\anubis-benchmark\\tools\\' + $toolingCommit))) {",
          "    if (((Get-Item -LiteralPath $directory).Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw \"REPAIR_DIRECTORY_REPARSE_POINT_REJECTED:$directory\" }",
          "}",
          "$mutex = [Threading.Mutex]::new($false, 'Global\\QQ-LMAX-Demo-Anubis-Cycle')",
          "$held = $false",
          "try {",
          "    $held = $mutex.WaitOne(0)",
          "    if (-not $held) { throw 'REPAIR_ANUBIS_CYCLE_RUNNING' }",
          "    if (@(Get-Process -Name PRODAnubisV4 -ErrorAction SilentlyContinue).Count -ne 0) { throw 'REPAIR_NATIVE_ENGINE_RUNNING' }",
          "    foreach ($file in @($target, $materializer, (Join-Path $toolRoot 'contracts\\infx7-infx10-constituent-hashes-v1.json'),",
          "            (Join-Path ('D:\\anubis-benchmark\\tools\\' + $toolingCommit) 'validation\\benchmark_bundle_source_inventory.json'),",
          "            'D:\\anubis-benchmark\\immutable\\82d48f018efb9803c1f448964e3f77421edaba1b4b547a2e866807c83bf791b6\\bin\\PRODAnubisV4.exe',",
          "            'C:\\Program Files\\nodejs\\node.exe')) { Require-File $file }",
          "    if ((File-Hash $target) -ne $oldHash) { throw 'REPAIR_PREVIOUS_WRAPPER_HASH_MISMATCH' }",
          "    if ((File-Hash $materializer) -ne $materializerHash) { throw 'REPAIR_MATERIALIZER_HASH_MISMATCH' }",
          "    foreach ($name in $toolingBlobs.Keys) {",
          "        $file = Join-Path $toolRoot ('src\\' + $name)",
          "        Require-File $file",
          "        $bytes = [IO.File]::ReadAllBytes($file)",
          "        [byte[]]$payload = [Text.Encoding]::UTF8.GetBytes(('blob ' + $bytes.Length + [char]0)) + $bytes",
          "        $sha1 = [Security.Cryptography.SHA1]::Create()",
          "        try { $blob = ([BitConverter]::ToString($sha1.ComputeHash($payload))).Replace('-', '').ToLowerInvariant() }",
          "        finally { $sha1.Dispose() }",
          "        if ($blob -ne $toolingBlobs[$name]) { throw \"REPAIR_TOOLING_COMMIT_MISMATCH:$name\" }",
          "    }",
          "    if ((Test-Path -LiteralPath $backup) -or (Test-Path -LiteralPath $pending)) { throw 'REPAIR_ALREADY_ATTEMPTED_OR_UNRESOLVED' }",
          "    [byte[]]$newBytes = [Convert]::FromBase64String('')",
          "    $sha256 = [Security.Cryptography.SHA256]::Create()",
          "    try { $payloadHash = ([BitConverter]::ToString($sha256.ComputeHash($newBytes))).Replace('-', '').ToLowerInvariant() }",
          "    finally { $sha256.Dispose() }",
          "    if ($payloadHash -ne $newHash) { throw 'REPAIR_EMBEDDED_WRAPPER_HASH_MISMATCH' }",
          "    $tokens = $null",
          "    $parseErrors = $null",
          "    [Management.Automation.Language.Parser]::ParseInput([Text.Encoding]::UTF8.GetString($newBytes), [ref]$tokens, [ref]$parseErrors) | Out-Null",
          "    if (@($parseErrors).Count -ne 0) { throw 'REPAIR_WRAPPER_PARSE_FAILED' }",
          "    # All read-only preconditions pass before any file write.",
          "    if ([DateTimeOffset]::UtcNow -ge $expires) { throw 'REPAIR_EXPIRED' }",
          "    $stream = [IO.File]::Open($pending, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)",
          "    try { $stream.Write($newBytes, 0, $newBytes.Length); $stream.Flush($true) }",
          "    finally { $stream.Dispose() }",
          "    if ((File-Hash $pending) -ne $newHash -or (File-Hash $target) -ne $oldHash) { throw 'REPAIR_PRE_REPLACE_HASH_MISMATCH' }",
          "    if ([DateTimeOffset]::UtcNow -ge $expires) { throw 'REPAIR_EXPIRED' }",
          "    [IO.File]::Replace($pending, $target, $backup, $false)",
          "    if ((File-Hash $target) -ne $newHash -or (File-Hash $backup) -ne $oldHash) { throw 'REPAIR_POST_REPLACE_HASH_MISMATCH_PRESERVE_FILES' }",
          "    [pscustomobject]@{",
          "        marker = 'LMAX_DEMO_ANUBIS_RUNTIME_REPAIR_INSTALLED'",
          "        installed_at_utc = [DateTimeOffset]::UtcNow.ToString('O')",
          "        expires_at_utc = $expires.ToString('O')",
          "        host_name = $env:COMPUTERNAME",
          "        source_commit = '0bad940c2f69fd095a364267ad389183dd7afcc2'",
          "        target_path = $target",
          "        target_sha256 = File-Hash $target",
          "        backup_path = $backup",
          "        backup_sha256 = File-Hash $backup",
          "        materializer_sha256 = File-Hash $materializer",
          "        tooling_commit = $toolingCommit",
          "        tooling_module_count = $toolingBlobs.Count",
          "        native_engine_started = $false",
          "        broker_send_status = 'DISABLED_NO_ORDER_ENTRY'",
          "        effective_execution_policy = [string](Get-ExecutionPolicy)",
          "    } | ConvertTo-Json -Depth 4 -Compress",
          "}",
          "finally {",
          "    if ($held) { $mutex.ReleaseMutex() | Out-Null }",
          "    $mutex.Dispose()",
          "}"
        ]
      }
    }
  ]
}
